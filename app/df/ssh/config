################################################################################
# ~/.ssh/config (BASE - compatível com Windows + Linux/WSL)
#
# Contém:
# - Defaults globais (seguros e estáveis)
# - Hosts globais (GitHub + servidores)
# - Include de um arquivo por ambiente selecionado via symlink:
#       Include ~/.ssh/config.local
#
# Regra:
# - Não usar aqui sintaxe Unix-only (ex.: Match exec/test -S) para não quebrar no Windows.
################################################################################

###########################
# Include por ambiente (must be parsed early for identityagent policy)
###########################
# Config generated by 1Password with allowed public keys.
Include ~/.ssh/1Password/config

# Environment-specific config selected by bootstrap symlink.
Include ~/.ssh/config.local


###########################
# Defaults globais
###########################
Host github.com github-com
    # Força protocolo moderno
    # Opções: 2
    Protocol 2

    # Keepalive (evita quedas por inatividade)
    # Alternativas comuns: 30 | 60 | 120
    ServerAliveInterval 60

    # Quantas tentativas antes de desconectar
    # Alternativas: 3 | 5 | 10 | 30
    ServerAliveCountMax 30

    # Segurança: não encaminhar agent por padrão
    # Opções: yes | no
    ForwardAgent no

    ForwardX11 no
    ForwardX11Trusted no

    # Com agentes como 1Password, normalmente não faz sentido adicionar chaves automaticamente
    # Opções: yes | no | ask
    AddKeysToAgent no

    # Checagem de host key:
    # - yes        (mais seguro: exige known_hosts prévio)
    # - accept-new (bom equilíbrio: aceita na primeira vez e depois valida)
    # - no         (inseguro: NÃO recomendado)
    StrictHostKeyChecking accept-new


###########################
# GitHub (global)
###########################
Host github.com github-com
    HostName github.com
    User git

    # Agent-first policy with no local key fallback.
    IdentitiesOnly no
    IdentityFile none


###########################
# Hosts específicos (globais)
###########################
Host 54.234.244.188
    HostName 54.234.244.188
    User ubuntu
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

    # ATENÇÃO: .ppk (PuTTY) normalmente não funciona no OpenSSH.
    # Converta para OpenSSH e use:
    # IdentityFile ~/.ssh/id_rsa_sendy_openssh


Host 10.30.4.9
    HostName 10.30.4.9
    User azureuser
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

    # Preferir caminho ~/<...> para compatibilidade.
    # No Windows OpenSSH, "~/.ssh/..." também funciona (expande para o perfil do usuário).
    IdentityFile ~/.ssh/infra-eastus2-cr_mevo.pem

###########################
# Fabber VM (Oracle Cloud)
###########################
Host fabber
    HostName 163.176.198.47
    User ubuntu
    ForwardAgent yes
    StrictHostKeyChecking accept-new
    IdentitiesOnly yes

    # Fixed 2026-09-06: "IdentitiesOnly yes" alone had no effect here — this
    # main config's own top-of-file `Include ~/.ssh/1Password/config` (Match
    # all) and `Include ~/.ssh/config.local` (Host *, sets IdentityAgent +
    # IdentitiesOnly no) are parsed BEFORE this block, and OpenSSH's config
    # semantics are first-obtained-value-wins per keyword — so "IdentitiesOnly"
    # was already pinned to "no" by the time parsing reached this line,
    # silently making this block's own "yes" a no-op. Real symptom: SSH
    # offered all 8 keys the 1Password agent holds and the Oracle VM's
    # MaxAuthTries disconnected the session ("Too many authentication
    # failures") before ever reaching the correct key.
    # `IdentityFile` was NOT pre-set by those earlier blocks, so — same
    # working pattern already used above for the other VM hosts
    # (54.234.244.188, 10.30.4.9) — pinning it here narrows what's offered
    # regardless of the IdentitiesOnly override. Private key lives only in
    # 1Password (op item "fabber-oracle-cloud-ssh-key-2026-08-31"); this
    # file holds just the public half so OpenSSH can select the matching
    # identity from the agent without it touching disk.
    IdentityFile ~/.ssh/fabber-oracle-cloud.pub
